        "ref": "legacy:ramon-allones-specially-selected"
      },
      "field_score_original": "95/89",
      "field_club_score": 95,
      "field_event": {
        "ref": "legacy:meeting-123"
      },
      "field_third_first": "Молочный шоколад, цветочный оттенок и мускат.",
      "field_third_second": "Вкус стал крепче; участники отметили кожу, дерево и хлеб.",
      "field_third_last": "Кожа, хлеб и перец."
    },
    "created": "2009-11-20"
  },
